{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "trustgate project scan report v1.0",
  "type": "object",
  "required": ["version", "mode", "target", "score", "raw_score", "verdict", "partial", "summary", "files", "findings", "syntax_errors", "timing_ms"],
  "properties": {
    "version": { "const": "1.0" },
    "mode": { "enum": ["project", "changed"] },
    "target": { "type": "string" },
    "base": { "type": ["string", "null"] },
    "score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "raw_score": { "type": "integer", "maximum": 100 },
    "verdict": { "enum": ["PASS", "REVIEW", "BLOCK"] },
    "partial": { "type": "boolean" },
    "summary": {
      "type": "object",
      "required": ["files_scanned", "files_analyzed", "findings", "syntax_errors"],
      "properties": {
        "files_scanned": { "type": "integer", "minimum": 0 },
        "files_analyzed": { "type": "integer", "minimum": 0 },
        "findings": { "type": "integer", "minimum": 0 },
        "syntax_errors": { "type": "integer", "minimum": 0 }
      }
    },
    "files": { "type": "array" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "line", "detector", "severity", "message", "penalty"],
        "properties": {
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 0 },
          "detector": { "pattern": "^TG-D[0-9]{2}$" },
          "severity": { "enum": ["critical", "major", "minor"] },
          "message": { "type": "string" },
          "penalty": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "syntax_errors": { "type": "array" },
    "timing_ms": { "type": "object" }
  }
}
