{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "trustgate report v1.0",
  "type": "object",
  "required": ["version", "target", "score", "raw_score", "verdict", "partial", "layers", "timing_ms"],
  "properties": {
    "version": { "const": "1.0" },
    "target": { "type": "string" },
    "score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "raw_score": { "type": "integer", "maximum": 100 },
    "verdict": { "enum": ["PASS", "REVIEW", "BLOCK"] },
    "partial": { "type": "boolean" },
    "layers": {
      "type": "object",
      "required": ["static", "dynamic", "mutation"],
      "properties": {
        "static": {
          "type": "object",
          "required": ["ran", "findings"],
          "properties": {
            "ran": { "type": "boolean" },
            "findings": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["detector", "severity", "line", "message", "penalty"],
                "properties": {
                  "detector": { "pattern": "^TG-D[0-9]{2}$" },
                  "severity": { "enum": ["critical", "major", "minor"] },
                  "line": { "type": "integer", "minimum": 0 },
                  "message": { "type": "string" },
                  "penalty": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        },
        "dynamic": { "type": "object", "required": ["ran"] },
        "mutation": { "type": "object", "required": ["ran"] }
      }
    },
    "timing_ms": { "type": "object" }
  }
}
